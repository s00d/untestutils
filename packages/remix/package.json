{
  "name": "@untestutils/remix",
  "version": "0.6.5",
  "homepage": "https://s00d.github.io/untestutils/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git",
    "directory": "packages/remix"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@untestutils/core": "workspace:*",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "obuild": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@remix-run/dev": "*",
    "@remix-run/node": "*",
    "@remix-run/serve": "*"
  },
  "peerDependenciesMeta": {
    "@remix-run/dev": {
      "optional": true
    },
    "@remix-run/node": {
      "optional": true
    },
    "@remix-run/serve": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
