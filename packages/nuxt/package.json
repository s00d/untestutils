{
  "name": "@untestutils/nuxt",
  "version": "0.7.0",
  "description": "Nuxt recipes + in-process unit runtime, config, module, and Vitest environment",
  "homepage": "https://s00d.github.io/untestutils/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/runtime/entry.mjs",
    "./dist/runtime/browser-entry.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.mjs",
      "default": "./dist/runtime/index.mjs"
    },
    "./runtime/entry": {
      "types": "./dist/runtime/entry.d.ts",
      "import": "./dist/runtime/entry.mjs",
      "default": "./dist/runtime/entry.mjs"
    },
    "./runtime/nuxt-root": {
      "types": "./dist/runtime/nuxt-root.d.ts",
      "import": "./dist/runtime/nuxt-root.mjs",
      "default": "./dist/runtime/nuxt-root.mjs"
    },
    "./runtime/mocks/vue-devtools": {
      "types": "./dist/runtime/mocks/vue-devtools.d.ts",
      "import": "./dist/runtime/mocks/vue-devtools.mjs",
      "default": "./dist/runtime/mocks/vue-devtools.mjs"
    },
    "./runtime/browser-entry": {
      "types": "./dist/runtime/browser-entry.d.ts",
      "import": "./dist/runtime/browser-entry.mjs",
      "default": "./dist/runtime/browser-entry.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.mjs",
      "default": "./dist/config/index.mjs"
    },
    "./module": {
      "types": "./dist/module/index.d.ts",
      "import": "./dist/module/index.mjs",
      "default": "./dist/module/index.mjs"
    },
    "./environment": {
      "types": "./dist/environment/index.d.ts",
      "import": "./dist/environment/index.mjs",
      "default": "./dist/environment/index.mjs"
    },
    "./vitest-environment": {
      "types": "./dist/environment/index.d.ts",
      "import": "./dist/environment/index.mjs",
      "default": "./dist/environment/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@untestutils/core": "workspace:*",
    "@untestutils/vitest": "workspace:*",
    "c12": "^3.0.0",
    "defu": "catalog:",
    "destr": "catalog:",
    "estree-walker": "^3.0.3",
    "exsolve": "^1.1.1",
    "fake-indexeddb": "^6.2.5",
    "local-pkg": "^1.2.1",
    "magic-string": "^0.30.0",
    "node-fetch-native": "^1.6.7",
    "node-mock-http": "^1.0.5",
    "ofetch": "catalog:",
    "pathe": "catalog:",
    "radix3": "^1.1.2",
    "scule": "^1.3.0",
    "ufo": "^1.6.4",
    "unimport": "^6.5.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@types/estree": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@vue/test-utils": "catalog:",
    "obuild": "catalog:",
    "publint": "catalog:",
    "rollup": "^4.63.3",
    "typescript": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "peerDependencies": {
    "@nuxt/kit": "catalog:",
    "@testing-library/vue": "^8.0.0",
    "@vue/test-utils": "^2.4.0",
    "h3": ">=1.15.0",
    "happy-dom": ">=20.0.0",
    "jsdom": ">=27.0.0",
    "nuxt": "^3.0.0 || ^4.0.0",
    "vitest": "^4.0.0 || ^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@testing-library/vue": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
