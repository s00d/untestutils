      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./vitest-environment": {
      "import": "./dist/vitest-environment.mjs",
      "default": "./dist/vitest-environment.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.mjs",
      "default": "./dist/ai.mjs"
    },
    "./package.json": "./package.json",
    "./runtime/browser-entry": {
      "import": "./dist/runtime-browser-entry.mjs",
      "default": "./dist/runtime-browser-entry.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "c12": "^3.3.3",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "destr": "^2.0.5",
    "estree-walker": "^3.0.3",
    "exsolve": "^1.1.1",
    "fake-indexeddb": "^6.2.5",
    "local-pkg": "^1.2.1",
    "magic-string": "^0.30.21",
    "node-fetch-native": "^1.6.7",
    "node-mock-http": "^1.0.5",
    "nypm": "^0.6.10",
    "ofetch": "^1.5.1",
    "pathe": "^2.0.3",
    "radix3": "^1.1.2",
    "scule": "^1.3.0",
    "std-env": "^4.2.0",
    "tinyglobby": "^0.2.17",
    "ufo": "^1.6.4",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@untestutils/ai": "workspace:*",
    "@untestutils/astro": "workspace:*",
    "@untestutils/config": "workspace:*",
    "@untestutils/core": "workspace:*",
    "@untestutils/drivers": "workspace:*",
    "@untestutils/module": "workspace:*",
    "@untestutils/next": "workspace:*",
    "@untestutils/nuxt": "workspace:*",
    "@untestutils/perf": "workspace:*",
    "@untestutils/playwright": "workspace:*",
    "@untestutils/remix": "workspace:*",
    "@untestutils/runtime": "workspace:*",
    "@untestutils/solidstart": "workspace:*",
    "@untestutils/sveltekit": "workspace:*",
    "@untestutils/utils": "workspace:*",
    "@untestutils/vite": "workspace:*",
    "@untestutils/vitest": "workspace:*",
    "publint": "catalog:",
    "rolldown-plugin-dts": "^0.28.6",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.57",
    "@ai-sdk/google": "^4.0.75",
    "@ai-sdk/openai": "^4.0.70",
    "@ai-sdk/xai": "^5.0.3",
    "@nuxt/kit": "^4.5.2",
    "@playwright/test": "^1.63.0",
    "@vue/test-utils": "^2.5.1",
    "ai": "^7.0.106",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "playwright-core": "^1.63.0",
    "vitest": "^4.0.0 || ^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@vue/test-utils": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
