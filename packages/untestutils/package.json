{
  "name": "untestutils",
  "version": "0.4.4",
  "description": "Recipe-based test harness for Vitest and Playwright — shared prepare, multi-framework factories, optional AI codegen",
  "keywords": [
    "e2e",
    "harness",
    "nuxt",
    "playwright",
    "test-utils",
    "vitest"
  ],
  "homepage": "https://s00d.github.io/untestutils/",
  "bugs": {
    "url": "https://github.com/s00d/untestutils/issues"
  },
  "license": "MIT",
  "author": "s00d",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git"
  },
  "bin": {
    "untestutils": "./dist/cli-run.mjs"
  },
  "files": [
    "dist",
    "templates",
    "vitest-environment-untestutils",
    "vitest-environment-nuxt",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.mjs",
      "default": "./dist/vitest.mjs"
    },
    "./vitest/plugin": {
      "types": "./dist/vitest-plugin.d.ts",
      "import": "./dist/vitest-plugin.mjs",
      "default": "./dist/vitest-plugin.mjs"
    },
    "./vitest/global-setup": {
      "types": "./dist/vitest-global-setup.d.ts",
      "import": "./dist/vitest-global-setup.mjs",
      "default": "./dist/vitest-global-setup.mjs"
    },
    "./vitest/setup-file": {
      "types": "./dist/vitest-setup-file.d.ts",
      "import": "./dist/vitest-setup-file.mjs",
      "default": "./dist/vitest-setup-file.mjs"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.mjs",
      "default": "./dist/playwright.mjs"
    },
    "./playwright/pw-global-setup": {
      "types": "./dist/playwright-pw-global-setup.d.ts",
