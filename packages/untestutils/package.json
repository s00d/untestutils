{
  "name": "untestutils",
  "version": "0.5.4",
  "description": "Recipe-based test harness for Vitest and Playwright — thin facade over @untestutils/* packages",
  "keywords": [
    "e2e",
    "harness",
    "nuxt",
    "playwright",
    "test-utils",
    "vitest"
  ],
  "homepage": "https://s00d.github.io/untestutils/",
  "bugs": {
    "url": "https://github.com/s00d/untestutils/issues"
  },
  "license": "MIT",
  "author": "s00d",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git",
    "directory": "packages/untestutils"
  },
  "bin": {
    "untestutils": "./bin.mjs"
  },
  "files": [
    "dist",
    "bin.mjs",
    "vitest-environment-untestutils",
    "vitest-environment-nuxt",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/vitest-setup-file.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.mjs",
      "default": "./dist/vitest.mjs"
    },
    "./vitest/plugin": {
      "types": "./dist/vitest-plugin.d.ts",
      "import": "./dist/vitest-plugin.mjs",
      "default": "./dist/vitest-plugin.mjs"
    },
    "./vitest/global-setup": {
      "types": "./dist/vitest-global-setup.d.ts",
      "import": "./dist/vitest-global-setup.mjs",
      "default": "./dist/vitest-global-setup.mjs"
    },
    "./vitest/setup-file": {
      "types": "./dist/vitest-setup-file.d.ts",
      "import": "./dist/vitest-setup-file.mjs",
      "default": "./dist/vitest-setup-file.mjs"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.mjs",
      "default": "./dist/playwright.mjs"
    },
    "./playwright/pw-global-setup": {
      "types": "./dist/playwright-pw-global-setup.d.ts",
      "import": "./dist/playwright-pw-global-setup.mjs",
      "default": "./dist/playwright-pw-global-setup.mjs"
    },
    "./playwright/pw-global-teardown": {
      "types": "./dist/playwright-pw-global-teardown.d.ts",
      "import": "./dist/playwright-pw-global-teardown.mjs",
      "default": "./dist/playwright-pw-global-teardown.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "default": "./dist/nuxt.mjs"
    },
    "./perf": {
      "types": "./dist/perf.d.ts",
      "import": "./dist/perf.mjs",
      "default": "./dist/perf.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "default": "./dist/utils.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "default": "./dist/vite.mjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "default": "./dist/next.mjs"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.mjs",
      "default": "./dist/astro.mjs"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "import": "./dist/sveltekit.mjs",
      "default": "./dist/sveltekit.mjs"
    },
    "./remix": {
      "types": "./dist/remix.d.ts",
      "import": "./dist/remix.mjs",
      "default": "./dist/remix.mjs"
    },
    "./solidstart": {
      "types": "./dist/solidstart.d.ts",
      "import": "./dist/solidstart.mjs",
      "default": "./dist/solidstart.mjs"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "import": "./dist/command.mjs",
      "default": "./dist/command.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "default": "./dist/runtime.mjs"
    },
    "./runtime/entry": {
      "types": "./dist/runtime-entry.d.ts",
      "import": "./dist/runtime-entry.mjs",
      "default": "./dist/runtime-entry.mjs"
    },
    "./runtime/nuxt-root": {
      "types": "./dist/runtime-nuxt-root.d.ts",
      "import": "./dist/runtime-nuxt-root.mjs",
      "default": "./dist/runtime-nuxt-root.mjs"
    },
    "./runtime/mocks/vue-devtools": {
      "types": "./dist/runtime-mocks-vue-devtools.d.ts",
      "import": "./dist/runtime-mocks-vue-devtools.mjs",
      "default": "./dist/runtime-mocks-vue-devtools.mjs"
    },
    "./runtime/browser-entry": {
      "types": "./dist/runtime-browser-entry.d.ts",
      "import": "./dist/runtime-browser-entry.mjs",
      "default": "./dist/runtime-browser-entry.mjs"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./vitest-environment": "./vitest-environment-untestutils/index.mjs",
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.mjs",
      "default": "./dist/ai.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@untestutils/cli": "workspace:*",
    "@untestutils/core": "workspace:*",
    "@untestutils/nuxt": "workspace:*",
    "@untestutils/playwright": "workspace:*",
    "@untestutils/utils": "workspace:*",
    "@untestutils/vitest": "workspace:*",
    "vitest-environment-untestutils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@untestutils/ai": "workspace:*",
    "@untestutils/astro": "workspace:*",
    "@untestutils/next": "workspace:*",
    "@untestutils/nuxt": "workspace:*",
    "@untestutils/perf": "workspace:*",
    "@untestutils/remix": "workspace:*",
    "@untestutils/solidstart": "workspace:*",
    "@untestutils/sveltekit": "workspace:*",
    "@untestutils/vite": "workspace:*",
    "obuild": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0",
    "@untestutils/ai": "0.5.4",
    "@untestutils/astro": "0.5.4",
    "@untestutils/next": "0.5.4",
    "@untestutils/perf": "0.5.4",
    "@untestutils/remix": "0.5.4",
    "@untestutils/solidstart": "0.5.4",
    "@untestutils/sveltekit": "0.5.4",
    "@untestutils/vite": "0.5.4",
    "playwright-core": "^1.63.0",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@untestutils/ai": {
      "optional": true
    },
    "@untestutils/astro": {
      "optional": true
    },
    "@untestutils/next": {
      "optional": true
    },
    "@untestutils/perf": {
      "optional": true
    },
    "@untestutils/remix": {
      "optional": true
    },
    "@untestutils/solidstart": {
      "optional": true
    },
    "@untestutils/sveltekit": {
      "optional": true
    },
    "@untestutils/vite": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
