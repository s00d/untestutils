      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "default": "./dist/next.mjs"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.mjs",
      "default": "./dist/astro.mjs"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "import": "./dist/sveltekit.mjs",
      "default": "./dist/sveltekit.mjs"
    },
    "./remix": {
      "types": "./dist/remix.d.ts",
      "import": "./dist/remix.mjs",
      "default": "./dist/remix.mjs"
    },
    "./solidstart": {
      "types": "./dist/solidstart.d.ts",
      "import": "./dist/solidstart.mjs",
      "default": "./dist/solidstart.mjs"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "import": "./dist/command.mjs",
      "default": "./dist/command.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "default": "./dist/runtime.mjs"
    },
    "./runtime/entry": {
      "import": "./dist/runtime-entry.mjs",
      "default": "./dist/runtime-entry.mjs"
    },
    "./runtime/nuxt-root": "./dist/runtime-nuxt-root.mjs",
    "./runtime/mocks/vue-devtools": "./dist/runtime-mocks-vue-devtools.mjs",
