{
  "name": "@untestutils/ai",
  "version": "0.5.1",
  "homepage": "https://s00d.github.io/untestutils/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git",
    "directory": "packages/ai"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@untestutils/core": "workspace:*",
    "pathe": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "obuild": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/xai": "catalog:",
    "ai": "catalog:",
    "playwright-core": "catalog:"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
