{
  "name": "@untestutils/utils",
  "version": "0.6.2",
  "description": "Shared e2e/test utilities — cookies, SEO head, poll, browser helpers",
  "homepage": "https://s00d.github.io/untestutils/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "obuild && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "publint": "publint --strict"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "obuild": "catalog:",
    "playwright-core": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "playwright-core": "catalog:"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
