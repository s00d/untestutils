{
  "name": "@untestutils/perf",
  "version": "0.4.4",
  "private": true,
  "description": "Build + load performance harness for recipe/fixture targets",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"console.log('[@untestutils/perf] private — use root pnpm run build (facade only)')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@untestutils/core": "workspace:*",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "peerDependencies": {
    "artillery": "*",
    "autocannon": "*"
  },
  "peerDependenciesMeta": {
    "autocannon": {
      "optional": true
    },
    "artillery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
