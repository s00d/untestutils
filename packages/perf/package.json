{
  "name": "@untestutils/perf",
  "version": "0.1.5",
  "private": true,
  "description": "Build + load performance harness for recipe/fixture targets",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@untestutils/core": "workspace:*",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "peerDependencies": {
    "autocannon": "*",
    "artillery": "*"
  },
  "peerDependenciesMeta": {
    "autocannon": {
      "optional": true
    },
    "artillery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
