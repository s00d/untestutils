    "publint": "publint --strict"
  },
  "dependencies": {
    "consola": "catalog:",
    "ofetch": "catalog:",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
