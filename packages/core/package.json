{
  "name": "@untestutils/core",
  "version": "0.4.4",
  "description": "Recipe harness core — locks, registry, orchestrator, drivers",
  "license": "MIT",
  "homepage": "https://s00d.github.io/untestutils/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./drivers": {
      "types": "./dist/drivers/index.d.ts",
      "import": "./dist/drivers/index.mjs",
      "default": "./dist/drivers/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "obuild && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "publint": "publint --strict"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "consola": "catalog:",
    "ofetch": "catalog:",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "obuild": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
