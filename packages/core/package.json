{
  "name": "@untestutils/core",
  "version": "0.1.9",
  "private": true,
  "description": "Recipe harness core — locks, registry, orchestrator",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
