{
  "name": "@untestutils/sveltekit",
  "version": "0.7.0",
  "homepage": "https://s00d.github.io/untestutils/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git",
    "directory": "packages/sveltekit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/runtime/entry.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./environment": {
      "types": "./dist/environment/index.d.ts",
      "import": "./dist/environment/index.mjs",
      "default": "./dist/environment/index.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.mjs",
      "default": "./dist/config/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.mjs",
      "default": "./dist/runtime/index.mjs"
    },
    "./runtime/entry": {
      "types": "./dist/runtime/entry.d.ts",
      "import": "./dist/runtime/entry.mjs",
      "default": "./dist/runtime/entry.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@untestutils/core": "workspace:*",
    "@untestutils/vitest": "workspace:*",
    "defu": "catalog:",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "obuild": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/kit": "*",
    "happy-dom": ">=20.0.0",
    "vite": "*",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
