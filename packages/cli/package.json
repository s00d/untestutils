{
  "name": "@untestutils/cli",
  "version": "0.4.4",
  "private": true,
  "description": "CLI for untestutils: init, convert, ai, doctor, and monorepo commands (bundled into the untestutils facade for npm)",
  "license": "MIT",
  "bin": {
    "untestutils": "./bin.mjs"
  },
  "files": [
    "src",
    "bin.mjs"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts",
      "default": "./src/main.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"console.log('[@untestutils/cli] private — use root pnpm run build (facade only)')\"",
    "cli": "tsx ./src/run.ts"
  },
  "dependencies": {
    "@untestutils/ai": "workspace:*",
    "@untestutils/core": "workspace:*",
    "@untestutils/perf": "workspace:*",
    "citty": "catalog:",
    "consola": "catalog:",
    "nypm": "catalog:",
    "pathe": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
