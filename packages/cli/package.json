{
  "name": "@untestutils/cli",
  "version": "0.4.4",
  "description": "CLI for untestutils: init, convert, ai, doctor, and monorepo commands",
  "license": "MIT",
  "homepage": "https://s00d.github.io/untestutils/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git",
    "directory": "packages/cli"
  },
  "bin": {
    "untestutils": "./bin.mjs"
  },
  "files": [
    "src",
    "bin.mjs",
    "templates"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts",
      "default": "./src/main.ts"
    },
    "./bin.mjs": "./bin.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "cli": "tsx ./src/run.ts",
    "build": "node -e \"console.log('[@untestutils/cli] src+tsx — no emit')\"",
    "publint": "publint --strict"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@untestutils/ai": "workspace:*",
    "@untestutils/core": "workspace:*",
    "@untestutils/perf": "workspace:*",
    "citty": "catalog:",
    "consola": "catalog:",
    "nypm": "catalog:",
    "pathe": "catalog:",
    "tinyglobby": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
