{
  "name": "@untestutils/vitest",
  "version": "0.7.1",
  "homepage": "https://s00d.github.io/untestutils/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git",
    "directory": "packages/vitest"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/setup-file.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs",
      "default": "./dist/plugin.mjs"
    },
    "./global-setup": {
      "types": "./dist/global-setup.d.ts",
      "import": "./dist/global-setup.mjs",
      "default": "./dist/global-setup.mjs"
    },
    "./setup-file": {
      "types": "./dist/setup-file.d.ts",
      "import": "./dist/setup-file.mjs",
      "default": "./dist/setup-file.mjs"
    },
    "./unit-lifecycle": {
      "types": "./dist/unit-lifecycle/index.d.ts",
      "import": "./dist/unit-lifecycle/index.mjs",
      "default": "./dist/unit-lifecycle/index.mjs"
    },
    "./package.json": "./package.json",
    "./unit-dom": {
      "types": "./dist/unit-dom/index.d.ts",
      "import": "./dist/unit-dom/index.mjs",
      "default": "./dist/unit-dom/index.mjs"
    },
    "./unit-marker": {
      "types": "./dist/unit-marker/index.d.ts",
      "import": "./dist/unit-marker/index.mjs",
      "default": "./dist/unit-marker/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@untestutils/core": "workspace:*",
    "defu": "catalog:",
    "fake-indexeddb": "^6.2.5",
    "local-pkg": "^1.2.1",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "obuild": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": "catalog:",
    "happy-dom": ">=20.0.0",
    "jsdom": ">=27.0.0",
    "playwright-core": "catalog:",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
