{
  "name": "@untestutils/monorepo",
  "version": "0.5.2",
  "private": true,
  "homepage": "https://s00d.github.io/untestutils/",
  "bugs": {
    "url": "https://github.com/s00d/untestutils/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/untestutils.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "dev": "pnpm run build",
    "cli": "tsx packages/cli/src/run.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/utils/tsconfig.json && tsc --noEmit -p packages/perf/tsconfig.json && tsc --noEmit -p packages/vitest/tsconfig.json && tsc --noEmit -p packages/playwright/tsconfig.json && tsc --noEmit -p packages/ai/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest watch --config vitest.unit.config.ts",
    "test:types": "vitest run --config vitest.types.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:playground": "pnpm --filter @untestutils/playground test",
    "test:playground:unit": "pnpm --filter @untestutils/playground test:unit-nuxt && pnpm --filter @untestutils/playground test:unit-nuxt-server",
    "test:playwright": "pnpm --filter @untestutils/playground test:playwright",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:ai": "vitest run --config vitest.ai.config.ts",
    "test:pack": "tsx scripts/pack-test.ts",
    "publint": "pnpm -r --filter './packages/**' run --if-present publint",
    "api:surface": "tsx scripts/api-surface.ts",
    "api:surface:update": "tsx scripts/api-surface.ts --update",
    "preflight": "tsx scripts/preflight.ts",
    "clean": "rm -rf packages/*/dist .untestutils test-results",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "docs:dev": "pnpm --filter @untestutils/docs dev",
    "docs:build": "pnpm --filter @untestutils/docs build",
    "docs:preview": "pnpm --filter @untestutils/docs preview",
    "changelog": "changelogen",
    "release:patch": "tsx scripts/release.ts patch",
    "release:minor": "tsx scripts/release.ts minor",
    "release:major": "tsx scripts/release.ts major"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@untestutils/cli": "workspace:*",
    "@untestutils/core": "workspace:*",
    "@untestutils/playwright": "workspace:*",
    "@untestutils/vitest": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "bumpp": "catalog:",
    "changelogen": "catalog:",
    "citty": "catalog:",
    "consola": "catalog:",
    "nuxt": "catalog:",
    "nypm": "catalog:",
    "obuild": "^0.4.40",
    "ofetch": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "pathe": "catalog:",
    "playwright-core": "catalog:",
    "publint": "catalog:",
    "tinyglobby": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "untestutils": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
